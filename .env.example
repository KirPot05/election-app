# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# Application connection. On Vercel + Neon use the *pooled* connection string
# (host contains "-pooler"). Locally, `npm run db:local` serves port 54329.
DATABASE_URL=postgres://postgres:postgres@localhost:54329/election_dev

# Optional: direct (unpooled) Neon connection used by `npm run db:migrate`.
# Falls back to DATABASE_URL when unset.
# DATABASE_URL_UNPOOLED=

# ---------------------------------------------------------------------------
# Environment identification
# ---------------------------------------------------------------------------
# "production" blocks development seeding and forces Secure cookies.
# Vercel sets VERCEL_ENV automatically; APP_ENV lets you be explicit.
APP_ENV=development

# Public base URL used to build password-recovery links shown to the admin.
# Optional: when unset, the URL of the incoming admin request is used.
# APP_URL=https://your-project.vercel.app

# ---------------------------------------------------------------------------
# Administrator bootstrap (used only by `npm run admin:create`)
# ---------------------------------------------------------------------------
# You can pass these as env vars instead of answering prompts. Never commit
# real values. The password must be at least 12 characters.
# ADMIN_USERNAME=
# ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Optional configuration
# ---------------------------------------------------------------------------
# Regex that a normalized (upper-cased, whitespace-free) registration number
# must match. Default: 3-32 chars of A-Z, 0-9, "/", "-", "." and "_".
# REGISTRATION_NUMBER_PATTERN=^[A-Z0-9][A-Z0-9/._-]{2,31}$

# Session lifetimes in hours.
# VOTER_SESSION_HOURS=168
# ADMIN_SESSION_HOURS=12

# Recovery-link lifetime in minutes (default 15).
# RECOVERY_TOKEN_MINUTES=15

# Local HTTP only: set to "true" to allow non-Secure cookies when running a
# production build on http://localhost (used by E2E tests). Ignored on Vercel.
# ALLOW_INSECURE_COOKIES=false

# Test databases (local + CI). Names must contain "test" or "e2e".
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:54329/election_test
E2E_DATABASE_URL=postgres://postgres:postgres@localhost:54329/election_e2e
